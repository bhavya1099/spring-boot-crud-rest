package br.com.example.davidarchanjo.application;import br.com.example.davidarchanjo.service.AppService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.CommandLineRunner;
import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;
import org.springframework.boot.autoconfigure.domain.EntityScan;
import org.springframework.data.jpa.repository.config.EnableJpaRepositories;

public class CrudRestApplicationRunTest {
    @Mock
    private AppService service;
    @InjectMocks
    private CRUDRestApplication crudRestApplication;
    @BeforeEach
    public void setUp() {
        MockitoAnnotations.openMocks(this);
    }
    @Test
    @Tag("valid")
    public void testServicePopulateCalled() {
        crudRestApplication.run();
        verify(service, times(1)).populate();
    }
    @Test
    @Tag("valid")
    public void testRunHandlesNullArguments() {
        assertDoesNotThrow(() -> crudRestApplication.run((String[]) null));
    }
    @Test
    @Tag("valid")
    public void testRunHandlesEmptyArguments() {
        assertDoesNotThrow(() -> crudRestApplication.run(new String[0]));
    }
    @Test
    @Tag("invalid")
    public void testRunHandlesPopulateException() {
        doThrow(new RuntimeException("Test Exception")).when(service).populate();
        assertThrows(RuntimeException.class, () -> crudRestApplication.run());
    }
    @Test
    @Tag("valid")
    public void testRunDoesNotModifyServiceInstance() {
        AppService originalService = (AppService) ReflectionTestUtils.getField(crudRestApplication, "service");
        crudRestApplication.run();
        AppService newService = (AppService) ReflectionTestUtils.getField(crudRestApplication, "service");
        assertSame(originalService, newService, "Service instance should not be modified");
    }
}