    @Test
    @Tag("integration")
    public void testConcurrentUpdateAttempts() throws InterruptedException {
        AppDTO existingAppDto = new AppDTO();
        App existingApp = new App();
        Long appId = 1L;
        when(repository.findById(appId)).thenReturn(Optional.of(existingApp));
        when(builder.build(any(AppDTO.class), any(App.class))).thenReturn(existingApp);
        when(repository.save(existingApp)).thenReturn(existingApp);
        when(builder.build(existingApp)).thenReturn(existingAppDto);
        Runnable updateTask = () -> appService.updateApp(appId, existingAppDto);
        Thread thread1 = new Thread(updateTask);
        Thread thread2 = new Thread(updateTask);
        thread1.start();
        thread2.start();
        thread1.join();
        thread2.join();
        verify(repository, times(2)).findById(appId);
        verify(builder, times(2)).build(any(AppDTO.class), any(App.class));
        verify(repository, times(2)).save(existingApp);
        verify(builder, times(2)).build(existingApp);
    }
