    @Test
    @Tag("valid")
    public void testSuccessfullyUpdateExistingApp() {
        AppDTO existingAppDto = new AppDTO();
        App existingApp = new App();
        Long appId = 1L;
        when(repository.findById(appId)).thenReturn(Optional.of(existingApp));
        when(builder.build(existingAppDto, existingApp)).thenReturn(existingApp);
        when(repository.save(existingApp)).thenReturn(existingApp);
        when(builder.build(existingApp)).thenReturn(existingAppDto);
        Optional<AppDTO> result = appService.updateApp(appId, existingAppDto);
        assertEquals(Optional.of(existingAppDto), result);
        verify(repository).findById(appId);
        verify(builder).build(existingAppDto, existingApp);
        verify(repository).save(existingApp);
        verify(builder).build(existingApp);
    }
    @Test
    @Tag("invalid")
    public void testAttemptToUpdateNonExistingApp() {
        AppDTO appDto = new AppDTO();
        Long appId = 1L;
        when(repository.findById(appId)).thenReturn(Optional.empty());
        AppNotFoundException exception = assertThrows(AppNotFoundException.class, () -> {
            appService.updateApp(appId, appDto);
        });
        assertEquals("No such App for id '1'", exception.getMessage());
        verify(repository).findById(appId);
    }
